# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://coffey:your-postgres-password@localhost:5432/coffey_pickem
POSTGRES_PASSWORD=your-postgres-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_PASSWORD=your-redis-password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-long-random-secret-32-chars-minimum
JWT_REFRESH_SECRET=replace-with-different-long-random-secret

# ─── Sports Data APIs ─────────────────────────────────────────────────────────
THE_ODDS_API_KEY=your-the-odds-api-key

# ─── Firebase (Admin SDK) ─────────────────────────────────────────────────────
# Paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Email ────────────────────────────────────────────────────────────────────
# Option A: Resend
RESEND_API_KEY=re_your_resend_api_key
# Option B: SMTP (Nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://coffeyclub.example.com
PORT=4000
NODE_ENV=development

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
