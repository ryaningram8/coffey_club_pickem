{
  "name": "coffey-api",
  "version": "1.0.0",
  "description": "Coffey Club Pickem — API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:seed:teams": "tsx src/prisma/seedTeams.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.20.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "resend": "^6.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
