    "@fastify/cookie": "^9.3.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "bullmq": "^5.20.0",
    "ioredis": "^5.3.2",
    "axios": "^1.7.7",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/bcrypt": "^5.0.2",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0"
