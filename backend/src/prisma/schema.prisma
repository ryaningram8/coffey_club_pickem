generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Per-pool role — a user's standing within one specific SeasonMembership.
// Global admin status lives separately on User.isAdmin, not here.
enum PoolRole {
  player
  commissioner
}

enum Sport {
  college
  nfl
  mlb
}

enum SeasonStatus {
  upcoming
  active
  completed
}

enum WeekStatus {
  upcoming
  picks_open
  locked
  in_progress
  completed
}

enum GameStatus {
  scheduled
  in_progress
  final
  postponed
  cancelled
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String
  passwordHash      String?  // null when using Google OAuth
  googleId          String?  @unique
  isAdmin           Boolean  @default(false) // global, applies to every pool; per-pool standing is SeasonMembership.role
  venmoHandle       String?
  notificationPrefs Json     @default("{}")
  fcmTokens         String[] @default([])
  createdAt         DateTime @default(now())

  invitationsCreated  Invitation[]           @relation("CreatedBy")
  invitationRedemptions InvitationRedemption[]
  picks               Pick[]
  weeklyResults       WeeklyResult[]
  seasonStandings     SeasonStanding[]
  seasonMemberships   SeasonMembership[]
}

model Invitation {
  id        String    @id @default(uuid())
  code      String    @unique
  seasonId  String?
  email     String?   // targeted invite; null = anyone with the code
  createdBy String
  maxUses   Int?      // null = unlimited; a targeted (email-set) invite is always 1
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  season      Season?                @relation(fields: [seasonId], references: [id])
  creator     User                   @relation("CreatedBy", fields: [createdBy], references: [id])
  redemptions InvitationRedemption[]
}

// One row per user who has redeemed a given invite code — lets a single
// shared code (maxUses > 1) be used by many people, while still keeping a
// per-person redemption record (who, when) and preventing the same user
// from redeeming the same code twice.
model InvitationRedemption {
  id           String   @id @default(uuid())
  invitationId String
  userId       String
  redeemedAt   DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([invitationId, userId])
}

model Season {
  id             String       @id @default(uuid())
  name           String       // e.g. "2025 Season"
  year           Int
  status         SeasonStatus @default(upcoming)
  entryFee       Decimal      @default(0) @db.Decimal(10, 2)
  payout1stPct   Decimal      @default(50) @db.Decimal(5, 2)
  payout2ndPct   Decimal      @default(30) @db.Decimal(5, 2)
  payout3rdPct   Decimal      @default(20) @db.Decimal(5, 2)
  defaultWeeklyPot Decimal?   @db.Decimal(10, 2) // seeds Week.pot on creation; edit per-week after that
  createdAt      DateTime     @default(now())

  weeks           Week[]
  invitations     Invitation[]
  seasonStandings SeasonStanding[]
  memberships     SeasonMembership[]
}

// A user's enrollment in a season/pool. A user can belong to more than one
// concurrently (e.g. a preseason test pool and the main regular-season pool)
// — this is what "active season"/"current week" resolution filters by, so
// each player only ever sees pools they've actually joined.
model SeasonMembership {
  id       String   @id @default(uuid())
  userId   String
  seasonId String
  role     PoolRole @default(player)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
}

model Week {
  id           String     @id @default(uuid())
  seasonId     String
  weekNumber   Int
  label        String     // e.g. "Week 7", "Bowl Week 1", "CFP Semifinal"
  pickDeadline DateTime   // hard cutoff — Friday 23:59:59 CT
  status       WeekStatus @default(upcoming)
  pot          Decimal?   @db.Decimal(10, 2) // this week's payout pool; split across top 3 by season payoutXPct
  commissionerMessage String? // free-text weekly roast, set by the commissioner, shown on the home screen
  createdAt    DateTime   @default(now())

  season        Season         @relation(fields: [seasonId], references: [id])
  games         Game[]
  picks         Pick[]
  weeklyResults WeeklyResult[]
}

model Team {
  id           String  @id @default(uuid())
  name         String
  abbreviation String
  logoUrl      String?
  sport        Sport
  conference   String?
  espnId       String // scoped per sport — ESPN reuses small integer IDs across leagues (e.g. "29" is both an NFL and a college team)

  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")
  wonGames  Game[] @relation("WinnerTeam")
  picks     Pick[]

  @@unique([sport, espnId])
}

model Game {
  id           String     @id @default(uuid())
  weekId       String
  sport        Sport
  homeTeamId   String
  awayTeamId   String
  gameTime     DateTime
  status       GameStatus @default(scheduled)
  homeScore    Int?
  awayScore    Int?
  winnerTeamId String?
  spread       Decimal?   @db.Decimal(5, 1) // display only; positive = home team favored
  overUnder    Decimal?   @db.Decimal(5, 1) // display only
  espnGameId   String? // scoped per week, NOT globally unique — the same real-world game can be independently selected into more than one pool's week at once
  displayOrder Int        @default(0)
  isNeutralSite Boolean   @default(false)
  venueName    String?
  venueCity    String?
  venueCountry String?
  createdAt    DateTime   @default(now())

  week       Week  @relation(fields: [weekId], references: [id])
  homeTeam   Team  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  winnerTeam Team? @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  picks      Pick[]

  @@unique([weekId, espnGameId])
}

model Pick {
  id           String   @id @default(uuid())
  userId       String
  gameId       String
  weekId       String
  pickedTeamId String
  isCorrect    Boolean? // null until game finalizes
  submittedAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id])
  game       Game @relation(fields: [gameId], references: [id])
  week       Week @relation(fields: [weekId], references: [id])
  pickedTeam Team @relation(fields: [pickedTeamId], references: [id])

  @@unique([userId, gameId]) // one pick per user per game
}

model WeeklyResult {
  id           String   @id @default(uuid())
  userId       String
  weekId       String
  correctPicks Int      @default(0)
  totalPicks   Int      @default(0)
  rank         Int?     // null until week is finalized
  payoutAmount Decimal? @db.Decimal(10, 2)
  isPaid       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
  week Week @relation(fields: [weekId], references: [id])

  @@unique([userId, weekId])
}

model SeasonStanding {
  id           String  @id @default(uuid())
  userId       String
  seasonId     String
  totalCorrect Int     @default(0)
  weeksPlayed  Int     @default(0)
  totalPayout  Decimal @default(0) @db.Decimal(10, 2)

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
}
